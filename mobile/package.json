    "expo-blur": "~56.0.3",
    "expo-crypto": "~56.0.4",
    "expo-font": "~56.0.7",
    "expo-haptics": "~56.0.3",
    "expo-linear-gradient": "~56.0.4",
    "expo-status-bar": "~56.0.4",
    "expo-web-browser": "~56.0.5",
    "firebase": "^12.14.0",
    "jest-expo": "~56.0.5",
    "react": "^19.2.3",
    "react-native": "^0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-magic-orb": "^0.1.8",
    "react-native-markdown-display": "^7.0.2",
    "react-native-reanimated": "4.3.1",
