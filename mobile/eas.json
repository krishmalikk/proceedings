{
  "cli": {
    "version": ">= 5.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "ios": { "simulator": true }
    },
    "production": {
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {
      "//": "Fill before submitting: Apple ASC API key (ascApiKeyPath/ascAppId) + Google service-account key (serviceAccountKeyPath, track)."
    }
  }
}
